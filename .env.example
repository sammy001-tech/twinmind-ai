# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional canonical public origin if reverse-proxy HTTPS causes origin-check mismatches.
# Use the deployed HTTPS origin only, without a path (e.g. https://your-service.onrender.com).
PUBLIC_APP_ORIGIN=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM BOT INTEGRATION (Optional - can also configure via UI Control Center)
# TELEGRAM_BOT_TOKEN: Obtained from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_OWNER_ID: Optional pre-locked numeric Telegram user ID for Olalekan.
# If omitted, pairing locks to Olalekan on the first /start or /pair command.
TELEGRAM_OWNER_ID=""

# TELEGRAM_MODE: "polling" (recommended, zero-config) or "webhook"
TELEGRAM_MODE="polling"

# TELEGRAM_WEBHOOK_URL: Required only if TELEGRAM_MODE is "webhook"
TELEGRAM_WEBHOOK_URL=""

# NEON SERVERLESS POSTGRESQL DATABASE (Hybrid: can set in .env or via Settings UI)
# DATABASE_URL: Standard PostgreSQL connection string from console.neon.tech
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=""

# OPTIONAL MULTI-MODEL EXTENSIONS:
GROQ_API_KEY=""
MISTRAL_API_KEY=""
TAVILY_API_KEY=""

# Generated files must survive production restarts/redeploys.
# Attach persistent storage and set ARTIFACTS_DIR to its absolute mount path in production.
# Production artifact generation fails closed when this is not configured.
ARTIFACTS_DIR=""

# TWILIO WHATSAPP INTEGRATION (For Proactive Calibration & Mobile Access)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""
USER_PHONE_NUMBER=""

# Optional HTTPS Twilio status callback endpoint for authoritative WhatsApp delivery/read/failure updates.
# Set the exact public HTTPS URL for this service endpoint; outbound Twilio requests attach it as statusCallback.
# Without it, TwinMind records provider acceptance only and does not infer delivered/read status.
TWILIO_STATUS_CALLBACK_URL=""
