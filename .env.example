# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM BOT INTEGRATION (Optional - can also configure via UI Control Center)
# TELEGRAM_BOT_TOKEN: Obtained from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_OWNER_ID: Optional pre-locked numeric Telegram user ID for Olalekan.
# If omitted, pairing locks to Olalekan on the first /start or /pair command.
TELEGRAM_OWNER_ID=""

# TELEGRAM_MODE: "polling" (recommended, zero-config) or "webhook"
TELEGRAM_MODE="polling"

# TELEGRAM_WEBHOOK_URL: Required only if TELEGRAM_MODE is "webhook"
TELEGRAM_WEBHOOK_URL=""

# NEON SERVERLESS POSTGRESQL DATABASE (Hybrid: can set in .env or via Settings UI)
# DATABASE_URL: Standard PostgreSQL connection string from console.neon.tech
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=""

# OPTIONAL MULTI-MODEL EXTENSIONS:
GROQ_API_KEY=""
MISTRAL_API_KEY=""
TAVILY_API_KEY=""

# TWILIO WHATSAPP INTEGRATION (For Proactive Calibration & Mobile Access)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""
USER_PHONE_NUMBER=""
